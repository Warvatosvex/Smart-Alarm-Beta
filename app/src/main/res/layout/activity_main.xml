1<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartAlarm"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Разрешения (нажмите, чтобы выдать)"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Поверх других окон" />

        <Button
            android:id="@+id/btnPermExact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Точные будильники" />

        <Button
            android:id="@+id/btnPermBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Не оптимизировать батарею" />

        <Button
            android:id="@+id/btnPermFullScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Полноэкранные уведомления" />

        <Button
            android:id="@+id/btnPermNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Уведомления" />

        <Button
            android:id="@+id/btnTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Время: 07:00"
            android:textSize="20sp" />

        <com.example.smartalarm.AlarmSettingsView
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Будильник не установлен" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Поставить" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Отменить" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Серия будильников" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:text="Тест"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>